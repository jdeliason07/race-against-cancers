STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for the /api/stripe/webhook endpoint.
# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Sponsor-covered registrations (/register/invite/<code>) ---
# The secret in the invite link. Anyone with the link can register for free, so
# make it long and random: openssl rand -hex 16
# Leave blank to disable covered registration entirely.
COMP_REGISTRATION_CODE=
# How many free entries that link may create. Must be > 0 or the link is dead.
COMP_REGISTRATION_LIMIT=42

# --- Email, via Sender (sender.net) ---
# Settings -> API access tokens. Used by the /admin composer and the weekly
# referral report. Leave blank and both features stay switched off.
SENDER_API_TOKEN=
# A verified sending address on your Sender account. Falls back to CONTACT_EMAIL.
SENDER_FROM_EMAIL=events@raceagainstcancers.org

# --- Admin page (/admin) ---
# Password for the page that emails the waitlist. Minimum 12 characters; the
# page stays disabled below that. Generate one with: openssl rand -hex 16
ADMIN_PASSWORD=

# --- Weekly referral report (/api/referral-report) ---
# Any long random string. Vercel Cron sends it as a Bearer token; the endpoint
# refuses requests without it. Generate one with: openssl rand -hex 32
CRON_SECRET=
# Where the weekly report goes.
REPORT_EMAIL_TO=you@example.com
